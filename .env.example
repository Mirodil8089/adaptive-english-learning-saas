# ==============================================================================
# MINDQUEST AI — Environment Configuration (.env.example)
# Copy this file to .env for local or production deployment.
# NEVER commit real secrets or expose server keys to the frontend.
# ==============================================================================

# Server & Runtime
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-64-char-cryptographic-random-secret"
CSRF_SECRET="replace-with-64-char-csrf-hmac-secret"

# Database Configuration
# When DATABASE_URL is set, MINDQUEST AI connects to PostgreSQL (pg pool).
# When omitted in local preview, MINDQUEST AI uses persistent SQLite at ./data/mindquest.sqlite
# while keeping full PostgreSQL schema & migrations in /database/migrations/001_initial_schema.sql.
DATABASE_URL=""
SQLITE_PATH="./data/mindquest.sqlite"

# Initial Super Admin Bootstrap (only created if no super_admin exists)
SUPER_ADMIN_EMAIL="admin@mindquest.ai"
SUPER_ADMIN_INITIAL_PASSWORD="ChangeMe_Admin_2026!"

# AI Engine (Server-side only — never exposed to client)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
AI_DEFAULT_TEXT_MODEL="gemini-3.8-flash"
AI_DEFAULT_TTS_MODEL="gemini-3.8-flash-lite-tts"
AI_DEFAULT_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
AI_GLOBAL_DAILY_USD_CAP="50.00"

# Currency Display Rate (UZS per 1 USD, editable in Super Admin)
DEFAULT_USD_TO_UZS_RATE="12850"

# Stripe Payment Provider (International Cards — Sandbox / Live)
# Leave blank to keep Stripe clearly marked in Test / Unconfigured Sandbox state
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_SUCCESS_URL="http://localhost:3000/dashboard?billing=stripe_callback"
STRIPE_CANCEL_URL="http://localhost:3000/pricing?billing=canceled"

# Payme Uzbekistan Merchant API (JSON-RPC 2.0 Callback + Checkout)
# Official docs: https://developer.help.paycom.uz/
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_SECRET_KEY=""
PAYME_SANDBOX_MODE="true"
PAYME_CHECKOUT_URL="https://test.paycom.uz"

# Click Uzbekistan SHOP-API (Prepare / Complete Signed Webhooks)
# Official docs: https://docs.click.uz/
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_MERCHANT_USER_ID=""
CLICK_SECRET_KEY=""
CLICK_SANDBOX_MODE="true"
CLICK_CHECKOUT_URL="https://my.click.uz/services/pay"

# Optional Google OAuth Client ID (Client-side token verification)
VITE_GOOGLE_CLIENT_ID=""
